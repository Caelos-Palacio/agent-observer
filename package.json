{
  "name": "agent-observer-local",
  "version": "0.5.1",
  "private": true,
  "description": "Compact agent metadata logs and evidence-based usage reviews",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "agent-observer": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test && /usr/bin/python3 -m unittest discover -s test -p \"test_*_import.py\"",
    "start": "node src/cli.mjs",
    "test:codex": "/usr/bin/python3 -m unittest discover -s test -p test_codex_import.py -v",
    "test:broker": "/usr/bin/python3 -m unittest discover -s test -p test_broker_import.py -v",
    "evaluate": "node scripts/evaluate-review.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "license": "MIT",
  "exports": {
    ".": "./src/index.mjs",
    "./adapters/codex": "./src/codex.mjs",
    "./adapters/broker": "./src/broker.mjs",
    "./integrations/pi": "./integrations/pi-observer.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Caelos-Palacio/agent-observer.git"
  }
}
